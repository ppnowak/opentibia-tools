{
  "name": "opentibia-tools",
  "version": "2.0.0",
  "description": "Tibia client file toolkit (dat/spr/cwm) for every protocol version 7.10 - 15.x, with CLI and in-browser PWA editor",
  "type": "module",
  "main": "src/core/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "unpack-dat": "tsx src/cli/index.ts --mode=unpack-dat",
    "pack-dat": "tsx src/cli/index.ts --mode=pack-dat",
    "unpack-spr": "tsx src/cli/index.ts --mode=unpack-spr",
    "pack-spr": "tsx src/cli/index.ts --mode=pack-spr",
    "convert-to-png": "tsx src/cli/index.ts --mode=convert-to-png",
    "unpack-cwm": "tsx src/cli/index.ts --mode=unpack-cwm",
    "pack-cwm": "tsx src/cli/index.ts --mode=pack-cwm",
    "spr-to-cwm": "tsx src/cli/index.ts --mode=spr-to-cwm",
    "convert": "tsx src/cli/index.ts --mode=convert",
    "info": "tsx src/cli/index.ts --mode=info",
    "e2e": "tsx src/cli/index.ts e2e",
    "verify-packs": "tsx scripts/verify-packs.ts",
    "versions": "tsx src/cli/index.ts --mode=versions",
    "build:cli": "vite build -c vite.cli.config.ts",
    "prepare": "vite build -c vite.cli.config.ts --logLevel warn",
    "validate": "tsx src/cli/index.ts validate",
    "diff": "tsx src/cli/index.ts diff",
    "build-client": "tsx src/cli/index.ts build",
    "unpack-client": "tsx src/cli/index.ts unpack-client",
    "pack-client": "tsx src/cli/index.ts pack-client"
  },
  "author": "czarnowidz",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.2",
    "@types/node": "^26.6.2",
    "@types/yargs": "^17.0.35",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "fflate": "^0.8.3",
    "yargs": "^18.2.0"
  },
  "bin": {
    "opentibia-tools": "dist-cli/opentibia-tools.mjs"
  },
  "files": [
    "dist-cli",
    "src",
    "schemas",
    "action.yml",
    "README.md"
  ]
}
